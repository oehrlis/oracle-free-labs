# - Runtime database data (never commit) ---------------------------------------
# Deny by default, allow by exception. The previous pattern set ignored only
# named subtrees (dbconfig, FREE), so anything else a service wrote - RMAN
# backup pieces under data/xchange, wallet copies, wallet_pwd.txt - was tracked.
# A datafile or a keystore in version control is not recoverable by deleting it
# later, so this list must stay a whitelist.
/data/**

# Documentation and the directory markers a fresh clone needs
!/data/README.md
!/data/*/
!/data/*/README.md
!/data/*/dbconfig/
!/data/*/dbconfig/.gitkeep
!/data/*/dbconfig/README.md

# The image symlinks /opt/oracle/network/admin (TNS_ADMIN) to
# /opt/oracle/dbconfig/FREE. Without that directory the bind mount creates an
# empty dbconfig, the symlink dangles and DBCA aborts with DBT-60127.
!/data/*/dbconfig/FREE/
!/data/*/dbconfig/FREE/.gitkeep

# Oracle datafile directory of each service
!/data/*/FREE/
!/data/*/FREE/.gitkeep
!/data/*/FREE/README.md

# - Do not ignore config/common/data (we want .gitignore there to apply) -------
!config/common/data/
!config/common/data/.gitignore
!config/common/data/dpdump/
!config/common/data/dpdump/.gitignore
!config/common/data/pdbarch/
!config/common/data/pdbarch/.gitignore

# - Local environment files and local overrides --------------------------------
.env
.env.local
*.log
docker-compose.override.yml

# - OS junk --------------------------------------------------------------------
.DS_Store
Thumbs.db

# - Editor / IDE junk ----------------------------------------------------------
.vscode/
.idea/
*.swp
*~

# - Archive / export files -----------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.bak
*.dmp

# - Python / Node helpers (if used for tooling) --------------------------------
__pycache__/
node_modules/

# - EOF ------------------------------------------------------------------------
artefacts/notes.md
artefacts/notes2.md
# aitk-managed - do not commit (deployed from ai-toolkit)
# A project-own file under these paths needs an explicit `git add -f`.
.claude/skills/
.claude/rules/
.claude/commands/
.claude/agents/
.github/copilot-instructions.md
.claude/worktrees/

# Generated by scripts/render_mermaid.sh
doc/images/mermaid/.mermaid-config.json

# The end-to-end verification log is evidence, not noise - it is the source
# the test protocol in doc/ is generated from. Checked for secrets before
# being added.
!artefacts/tde-e2e-run-*.log
