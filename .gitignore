#              at http://www.apache.org/licenses/
# ------------------------------------------------------------------------------
# Modified...:
# see git revision history with git log for more information on changes
# ------------------------------------------------------------------------------

# - Runtime database data (never commit) ---------------------------------------
# Ignore only the top-level data directory contents
/data/*

# Keep a top-level README
!/data/README.md

# Keep service subfolders and their README.md files
!/data/*/
!/data/*/README.md

# Keep nested dbconfig and FREE directories (but not their contents by default)
!/data/*/dbconfig/
!/data/*/FREE/

# Still ignore actual DB files inside those
/data/*/dbconfig/*
/data/*/FREE/*
data/*/.FREE.created

# Keep the dbconfig/FREE directory itself - the image symlinks
# /opt/oracle/network/admin (TNS_ADMIN) to it. Without it DBCA fails
# with DBT-60127 on a fresh clone.
!/data/*/dbconfig/FREE/
!/data/*/dbconfig/FREE/.gitkeep

# Allow .gitkeep or README.md inside ignored dirs
!/data/*/dbconfig/.gitkeep
!/data/*/dbconfig/README.md
!/data/*/FREE/.gitkeep
!/data/*/FREE/README.md

# - Do not ignore config/common/data (we want .gitignore there to apply) -------
!config/common/data/
!config/common/data/.gitignore
!config/common/data/dpdump/
!config/common/data/dpdump/.gitignore
!config/common/data/pdbarch/
!config/common/data/pdbarch/.gitignore

# - Local environment files and local overrides --------------------------------
.env
.env.local
*.log
docker-compose.override.yml

# - OS junk --------------------------------------------------------------------
.DS_Store
Thumbs.db

# - Editor / IDE junk ----------------------------------------------------------
.vscode/
.idea/
*.swp
*~

# - Archive / export files -----------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.bak
*.dmp

# - Python / Node helpers (if used for tooling) --------------------------------
__pycache__/
node_modules/

# - EOF ------------------------------------------------------------------------
artefacts/notes.md
artefacts/notes2.md
# aitk-managed - do not commit (deployed from ai-toolkit)
# A project-own file under these paths needs an explicit `git add -f`.
.claude/skills/
.claude/rules/
.claude/commands/
.claude/agents/
.github/copilot-instructions.md
.claude/worktrees/
