# Modified...:
# see git revision history with git log for more information on changes
# ------------------------------------------------------------------------------
# - Runtime / Image ------------------------------------------------------------
DB_IMAGE=container-registry.oracle.com/database/free:latest
DB_MEM=8g
DB_SHM_SIZE=1g
TZ=Europe/Zurich

# - Ports (mapped to host) -----------------------------------------------------
LISTENER_PORT=1521
OEM_EXPRESS_PORT=5500

# - Database basics ------------------------------------------------------------
ORACLE_PWD=Oracle123
ORACLE_SID=FREE
ORACLE_PDB=FREEPDB1

# - Common host paths ----------------------------------------------------------
ORADATA_HOST=./data/cdbfree/FREE
DBCONFIG_HOST=./data/cdbfree/dbconfig
COMMON_DATA_HOST=./config/common/data

# - Service specific configurations --------------------------------------------
# - Plain Oracle 23ai Free -----------------------------------------------------
CDBFREE_LISTENER_PORT=1526      # CDB listener port
CDBFREE_OEM_EXPRESS_PORT=5506   # CDB OEM Express port

# - Empty DB for lab/engineering/tests -----------------------------------------
LABDB_LISTENER_PORT=1527        # LABDB listener port
LABDB_OEM_EXPRESS_PORT=5507     # LABDB OEM Express port

# - OraDBA repository via SQL scripts ------------------------------------------
ODBREPO_LISTENER_PORT=1528       # OraDBA repository listener port
ODBREPO_OEM_EXPRESS_PORT=5508    # OraDBA repository OEM Express port

# - OraDBA repository from PDB archive (seed) ----------------------------------
ODBSEED_LISTENER_PORT=1529       # OraDBA seed listener port
ODBSEED_OEM_EXPRESS_PORT=5509    # OraDBA seed OEM Express port

# - Complex OraDBA demo from PDB archive ---------------------------------------
ODBDEMO_LISTENER_PORT=1530       # OraDBA demo listener port
ODBDEMO_OEM_EXPRESS_PORT=5510    # OraDBA demo OEM Express port

# - EOF ------------------------------------------------------------------------