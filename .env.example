# - Runtime / Image ------------------------------------------------------------                                                            
# Build base image → produces oracle-free-labs:<tag> via 'make build'                                                                                    
DB_BASE_IMAGE=container-registry.oracle.com/database/free:23.9.0.0
# DB_IMAGE is auto-derived from DB_BASE_IMAGE via make. Override to pin a specific image:
# DB_IMAGE=container-registry.oracle.com/database/free:latest
# DB_IMAGE=oracle-free-labs:23.9.0.0
DB_MEM=8g
DB_SHM_SIZE=1g
TZ=Europe/Zurich

# - Ports (mapped to host) -----------------------------------------------------
LISTENER_PORT=1521
OEM_EXPRESS_PORT=5500

# - Database basics ------------------------------------------------------------
ORACLE_PWD=Oracle123
DB_ORACLE_SID=FREE
ORACLE_PDB=FREEPDB1

# - Common host paths ----------------------------------------------------------
ORADATA_HOST=./data/cdbfree/FREE
DBCONFIG_HOST=./data/cdbfree/dbconfig
COMMON_DATA_HOST=./config/common/data

# - Service specific configurations --------------------------------------------
# - Plain Oracle 23ai Free -----------------------------------------------------
CDBFREE_LISTENER_PORT=1526      # CDB listener port
CDBFREE_OEM_EXPRESS_PORT=5506   # CDB OEM Express port

# - Empty DB for lab/engineering/tests -----------------------------------------
LABDB_LISTENER_PORT=1527        # LABDB listener port
LABDB_OEM_EXPRESS_PORT=5507     # LABDB OEM Express port

# - OraDBA LAB via SQL scripts -------------------------------------------------
ODBREPO_LISTENER_PORT=1528      # OraDBA repository listener port
ODBREPO_OEM_EXPRESS_PORT=5508   # OraDBA repository OEM Express port

# - OraDBA LAB from PDB archive (seed) -----------------------------------------
ODBSEED_LISTENER_PORT=1529      # OraDBA seed listener port
ODBSEED_OEM_EXPRESS_PORT=5509   # OraDBA seed OEM Express port

# - Complex OraDBA LAB from PDB archive ----------------------------------------
ODBDEMO_LISTENER_PORT=1530      # OraDBA demo listener port
ODBDEMO_OEM_EXPRESS_PORT=5511   # OraDBA demo OEM Express port

# - Complex OraDBA LAB with TDE via SQL scripts --------------------------------
ODBENC_LISTENER_PORT=1531       # OraDBA demo listener port
ODBENC_OEM_EXPRESS_PORT=5511    # OraDBA demo OEM Express port

# - TDE restore verification test - Prod DB ------------------------------------
# No OEM Express port mapped: these services are used for test/lab only and
# the 5511 port is already allocated to odbenc / odbdemo.
# Memory limits are set to 3g each (instead of the default DB_MEM=8g) because
# both containers must run in parallel on a host with only 8 GB RAM. Oracle
# Free is constrained to 2 GB SGA anyway, so 3g is sufficient.
ODBENCPROD_LISTENER_PORT=1532   # TDE verification prod DB listener port
ODBENCPROD_DB_MEM=2g            # Memory limit for odbencprod (Oracle Free: max 2g SGA)

# - TDE restore verification test - Dev/target DB ------------------------------
ODBENCDEV_LISTENER_PORT=1533    # TDE verification dev DB listener port
ODBENCDEV_DB_MEM=2g             # Memory limit for odbencdev (Oracle Free: max 2g SGA)

# - EOF ------------------------------------------------------------------------