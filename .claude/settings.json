{
  "attribution": {
    "commit": ""
  },
  "autoApprove": {
    "read": true,
    "write": false,
    "execute": false
  },
  "permissions": {
    "allow": [
      "Bash(make lint)",
      "Bash(make lint *)",
      "Bash(make lint-markdown)",
      "Bash(make lint-shell)",
      "Bash(make lint-yaml)",
      "Bash(make help)",
      "Bash(make check-version)",
      "Bash(make ps)",
      "Bash(make logs)",
      "Bash(make logs *)",
      "Bash(make up-status)",
      "Bash(make config-check)",
      "Bash(make test)",
      "Bash(make test *)",
      "Bash(make build)",
      "Bash(make build *)",
      "Bash(make image)",
      "Bash(make image *)",
      "Bash(make -n *)",
      "Bash(docker compose *)",
      "Bash(docker exec *)",
      "Bash(docker run *)",
      "Bash(docker build *)",
      "Bash(shellcheck *)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(docker inspect:*)",
      "Bash(docker images:*)",
      "Bash(docker system df:*)",
      "Bash(docker network ls:*)",
      "Bash(docker volume ls:*)",
      "Bash(docker stop:*)",
      "Bash(docker start:*)",
      "Bash(docker restart:*)",
      "Bash(docker exec:*)",
      "Bash(docker compose:*)",
      "Bash(docker build:*)",
      "Bash(docker cp:*)",
      "Bash(make:*)",
      "Bash(shellcheck:*)",
      "Bash(markdownlint:*)",
      "Bash(yamllint:*)",
      "Bash(scripts/tde-verify/run_all.sh:*)",
      "Bash(./scripts/tde-verify/run_all.sh:*)",
      "Bash(scripts/tde-verify/tde_evidence.sh:*)",
      "Bash(scripts/render_mermaid.sh:*)",
      "Bash(python3:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(git clean:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "markdownlint --fix $CLAUDE_TOOL_OUTPUT_PATH 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
